# Database (MySQL/MariaDB)
DATABASE_URL="mysql://kelurahan:kelurahan@localhost:3316/kelurahan_bot"

# Bot control server (internal, localhost-only)
BOT_CONTROL_PORT=4001
BOT_CONTROL_URL="http://127.0.0.1:4001"
BOT_CONTROL_SECRET="ganti-dengan-string-acak-panjang"

# Web dashboard session
SESSION_COOKIE_NAME="kb_session"
SESSION_TTL_HOURS=12

# Storage (absolute or relative to repo root)
UPLOAD_DIR="./storage/uploads"
TMP_DIR="./storage/tmp"

# Baileys auth session folder
WA_AUTH_DIR="./apps/bot/.baileys_auth"
# NOTE: NODE_ENV sengaja TIDAK diset di sini. Next.js, tsx, dan node masing-masing
# sudah menentukan NODE_ENV yang benar per perintah (dev/build/start).
# Untuk deployment produksi, set NODE_ENV=production lewat process manager (pm2/systemd/docker),
# bukan lewat file .env yang dipakai bersama dev & build.
