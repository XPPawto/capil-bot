# Database (MySQL/MariaDB)
DATABASE_URL="mysql://kelurahan:kelurahan@localhost:3316/kelurahan_bot"

# Bot control server (internal, localhost-only)
BOT_CONTROL_PORT=4001
BOT_CONTROL_URL="http://127.0.0.1:4001"
BOT_CONTROL_SECRET="ganti-dengan-string-acak-panjang"

# Web dashboard session
SESSION_COOKIE_NAME="kb_session"
SESSION_TTL_HOURS=12

# Storage (absolute or relative to repo root)
UPLOAD_DIR="./storage/uploads"
TMP_DIR="./storage/tmp"

# Kunci AES-256 (64 karakter hex = 32 byte) untuk enkripsi berkas syarat warga saat disimpan.
# Generate dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WAJIB sama antara bot (yang menulis) dan web (yang membaca).
FILE_ENCRYPTION_KEY="ganti-dengan-64-karakter-hex-acak"

# Kunci AES-256 (64 karakter hex = 32 byte) TERPISAH dari kunci di atas - jangan pernah
# dipakai bersama. Isinya cuma dibaca web (apps/web/src/lib/accessControl.ts), tidak pernah
# ditulis lewat kode aplikasi mana pun - lihat packages/db/scripts/setAccessControl.ts.
ACCESS_CONTROL_KEY="ganti-dengan-64-karakter-hex-acak-yang-berbeda"

# Baileys auth session folder
WA_AUTH_DIR="./apps/bot/.baileys_auth"

# URL publik dashboard web (dipakai bot untuk menyisipkan link lacak status pengajuan
# ke pesan WA warga, mis. https://botcapil.simiku.tech). Tanpa trailing slash.
PUBLIC_WEB_URL="http://localhost:8450"

# Nama kelurahan, dipakai di teks watermark foto KTP warga.
KELURAHAN_NAME="Kelurahan Sukamaju"

# Redis (cache daftar syarat layanan di bot, supaya tidak query MySQL tiap warga buka menu)
REDIS_URL="redis://localhost:6379"

# Kunci HMAC-SHA256 (64 karakter hex = 32 byte) untuk buku besar audit yang membuktikan
# riwayat chat /admin-xpawto tidak diubah - lihat packages/db/src/auditLedger.ts. TERPISAH
# dari kunci-kunci lain di atas, jangan pernah dipakai bersama.
AUDIT_LEDGER_KEY="ganti-dengan-64-karakter-hex-acak-yang-berbeda"

# Notifikasi Telegram (opsional) - kosongkan berdua untuk menonaktifkan, lihat
# apps/bot/src/notify/telegramNotify.ts. Token didapat dari @BotFather, chat_id dari
# @userinfobot (atau endpoint getUpdates) untuk akun Telegram yang dituju.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_NOTIFY_CHAT_ID=""
# NOTE: NODE_ENV sengaja TIDAK diset di sini. Next.js, tsx, dan node masing-masing
# sudah menentukan NODE_ENV yang benar per perintah (dev/build/start).
# Untuk deployment produksi, set NODE_ENV=production lewat process manager (pm2/systemd/docker),
# bukan lewat file .env yang dipakai bersama dev & build.
