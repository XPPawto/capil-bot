generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ServiceType {
  /// Legacy - dipakai sebelum layanan KK dipecah jadi 3 sub-jenis. Dipertahankan supaya
  /// pengajuan lama tetap tampil benar; tidak lagi bisa dipilih warga untuk pengajuan baru.
  KARTU_KELUARGA
  KK_BARCODE
  KK_PISAH
  KK_TAMBAH_ANGGOTA
  AKTE_KEMATIAN
  AKTE_KELAHIRAN
}

enum RequestStatus {
  DICEK
  DIPROSES
  DITOLAK
  SELESAI
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

/// Akun petugas/admin dashboard.
model Admin {
  id               Int             @id @default(autoincrement())
  username         String          @unique
  passwordHash     String
  name             String
  failedLoginCount Int             @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  sessions         Session[]
  statusHistories  StatusHistory[]
  requestMessages  RequestMessage[]
  broadcasts       Broadcast[]
  humanTakeovers   HumanTakeover[]
  inboxMessages    InboxMessage[]
}

/// Kalau ada baris untuk suatu waJid, bot BERHENTI TOTAL membalas otomatis (menu/status/dsb)
/// ke nomor itu - petugas sedang mengambil alih percakapan lewat dashboard secara manual.
/// Pesan warga tetap dicatat ke RequestMessage supaya kelihatan di chat dashboard, bot cuma
/// tidak ikut-ikutan membalas. Baris dihapus saat petugas melepas toggle (bot aktif lagi).
model HumanTakeover {
  waJid       String   @id
  activatedAt DateTime @default(now())
  adminId     Int?
  admin       Admin?   @relation(fields: [adminId], references: [id])
}

/// Sesi login dashboard, disimpan di DB (bukan JWT) supaya logout = revoke langsung.
model Session {
  id        String   @id @default(cuid())
  adminId   Int
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([adminId])
}

/// Singleton (id selalu 1) yang merefleksikan status koneksi nomor WA bot untuk dashboard.
model BotSession {
  id              Int       @id @default(1)
  waJid           String?
  phoneNumber     String?
  connected       Boolean   @default(false)
  lastConnectedAt DateTime?
  updatedAt       DateTime  @updatedAt
}

/// State mesin percakapan per nomor WA, selama warga masih mengisi formulir/upload syarat.
/// Sengaja terpisah dari model Request supaya antrian admin cuma berisi pengajuan yang sudah lengkap.
model ConversationState {
  id                  Int      @id @default(autoincrement())
  waJid               String   @unique
  state               String
  requirementsSnapshot Json?
  contextJson         Json?
  expiresAt           DateTime
  /// Diisi sekali saat reminder "pengajuan belum selesai" terkirim, supaya warga tidak
  /// di-spam berkali-kali kalau tetap idle melewati beberapa siklus job pengingat.
  reminderSentAt      DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([expiresAt])
}

/// Daftar syarat dokumen per layanan, bisa diedit admin lewat dashboard.
model RequirementTemplate {
  id          Int         @id @default(autoincrement())
  serviceType ServiceType
  name        String
  description String?
  order       Int
  active      Boolean     @default(true)
  /// Kalau true, berkas yang dikirim warga untuk syarat ini akan di-OCR (dicari NIK-nya)
  /// sebagai petunjuk petugas - bukan pengganti verifikasi manual.
  ocrKtp      Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([serviceType])
}

/// Pengajuan warga yang sudah lengkap syaratnya (dibuat setelah semua dokumen terupload).
model Request {
  id                String        @id @default(cuid())
  /// Nomor tiket yang mudah dibacakan warga ke petugas, format KODE-YYMM-0001.
  ticketNumber      String        @unique
  serviceType       ServiceType
  applicantName     String
  waJid             String
  waNumber          String
  status            RequestStatus @default(DICEK)
  rejectionReason   String?
  pickupToken       String        @unique
  pickupTokenUsedAt DateTime?
  /// Token acak panjang untuk URL halaman lacak publik (/track/[trackingToken]) - SENGAJA
  /// terpisah dari pickupToken (yang dipakai scan QR fisik di loket). Tanpa ini, ticketNumber
  /// (sekuensial per layanan+bulan, gampang ditebak) bisa dipakai orang lain untuk melihat
  /// status/nama/alasan penolakan pemohon lain (IDOR) - trackingToken jadi "kunci" yang cuma
  /// dikirim bot ke WhatsApp pemohon aslinya.
  trackingToken     String        @unique
  qrGeneratedAt     DateTime?
  pickupConfirmedAt DateTime?
  completedAt       DateTime?
  notifiedStatus    RequestStatus?
  notifiedAt        DateTime?
  /// Diisi saat admin menekan "Kirim Notifikasi Siap Diambil" (bisa ditekan ulang untuk resend).
  readyForPickupRequestedAt DateTime?
  /// Diisi bot setelah pesan siap-diambil (berisi QR) benar-benar terkirim.
  readyForPickupSentAt      DateTime?
  /// Diisi sekali saat reminder otomatis "belum diambil" terkirim, supaya warga tidak di-spam berkali-kali.
  pickupReminderSentAt      DateTime?
  /// Diisi bot saat minta rating (begitu status SELESAI). Dipakai jadi jendela waktu balasan
  /// angka 1-5 dianggap sebagai rating, bukan pilihan menu layanan baru.
  ratingRequestedAt DateTime?
  ratingSubmittedAt DateTime?
  /// 1-5, diisi warga lewat balasan chat setelah dokumen diambil.
  rating            Int?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  documents       RequestDocument[]
  statusHistories StatusHistory[]
  messages        RequestMessage[]

  @@index([waJid])
  @@index([status])
}

/// Penghitung nomor urut tiket per layanan+bulan, di-increment atomik lewat raw SQL
/// (INSERT ... ON DUPLICATE KEY UPDATE ... LAST_INSERT_ID) supaya aman dari race condition
/// saat dua pengajuan pada layanan & bulan yang sama selesai hampir bersamaan.
model TicketSequence {
  id          Int         @id @default(autoincrement())
  serviceType ServiceType
  yearMonth   String
  lastNumber  Int         @default(0)

  @@unique([serviceType, yearMonth])
}

/// Nomor WA petugas yang dikabari otomatis tiap ada pengajuan baru masuk (status DICEK).
model StaffContact {
  id        Int      @id @default(autoincrement())
  waNumber  String
  label     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// Berkas syarat (foto/PDF) yang sudah dipindah ke penyimpanan permanen untuk sebuah Request.
model RequestDocument {
  id              Int      @id @default(autoincrement())
  requestId       String
  request         Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requirementName String
  fileName        String
  filePath        String
  mimeType        String
  uploadedAt      DateTime @default(now())
  /// Hasil OCR (kalau syaratnya ditandai ocrKtp) - petunjuk saja, petugas tetap wajib
  /// mencocokkan dengan foto aslinya secara manual.
  ocrNik          String?
  ocrRawText      String?  @db.Text

  @@index([requestId])
}

/// Log percakapan bebas (di luar alur formulir baku) antara petugas dan warga untuk satu
/// pengajuan - OUTBOUND = petugas kirim lewat dashboard, INBOUND = warga chat bebas ke bot
/// saat pengajuannya masih aktif (DICEK/DIPROSES).
model RequestMessage {
  id        Int              @id @default(autoincrement())
  requestId String
  request   Request          @relation(fields: [requestId], references: [id], onDelete: Cascade)
  direction MessageDirection
  message   String           @db.Text
  adminId   Int?
  admin     Admin?           @relation(fields: [adminId], references: [id])
  createdAt DateTime         @default(now())
  /// Diisi kalau pesan ini punya lampiran (mis. voice note warga yang tidak bisa dipahami
  /// bot - direkam & diteruskan apa adanya supaya petugas bisa dengar langsung). Path relatif
  /// ke UPLOAD_DIR, file-nya terenkripsi AES-256-GCM sama seperti berkas syarat lainnya.
  attachmentPath     String?
  attachmentMimeType String?

  @@index([requestId])
}

/// Log pengumuman massal admin ke semua warga yang pernah punya pengajuan (distinct waJid).
model Broadcast {
  id              Int      @id @default(autoincrement())
  message         String   @db.Text
  recipientCount  Int
  adminId         Int?
  admin           Admin?   @relation(fields: [adminId], references: [id])
  createdAt       DateTime @default(now())
}

/// Log SEMUA pesan masuk dari nomor WA manapun, terlepas dia punya Request aktif atau tidak -
/// beda dari RequestMessage yang cuma hidup dalam konteks satu pengajuan. Ini dipakai halaman
/// "Pesan Masuk" di dashboard supaya petugas bisa lihat & balas warga yang chat di luar alur
/// formulir (mis. baru sekadar tanya-tanya, belum pernah mengajukan apa pun).
model InboxMessage {
  id        Int              @id @default(autoincrement())
  waJid     String
  waNumber  String
  direction MessageDirection
  message   String           @db.Text
  adminId   Int?
  admin     Admin?           @relation(fields: [adminId], references: [id])
  createdAt DateTime         @default(now())

  @@index([waJid])
  @@index([createdAt])
}

/// Catatan monitoring: input warga/pengunjung yang polanya menyerupai percobaan SQL
/// Injection/XSS. Ini murni defense-in-depth logging (Prisma sudah parameterized query
/// di semua tempat jadi tidak ada celah SQLi nyata) - tujuannya supaya admin bisa lihat
/// kalau ada yang sedang mencoba probing sistem, bukan bukti sistem berhasil ditembus.
model SecurityLog {
  id        Int      @id @default(autoincrement())
  ip        String
  path      String
  field     String
  value     String   @db.Text
  pattern   String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([ip])
}

/// Jejak audit perubahan status tiap Request.
model StatusHistory {
  id          Int           @id @default(autoincrement())
  requestId   String
  request     Request       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  status      RequestStatus
  note        String?
  changedById Int?
  changedBy   Admin?        @relation(fields: [changedById], references: [id])
  changedAt   DateTime      @default(now())

  @@index([requestId])
}
