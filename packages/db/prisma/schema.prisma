generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ServiceType {
  /// Legacy - dipakai sebelum layanan KK dipecah jadi 3 sub-jenis. Dipertahankan supaya
  /// pengajuan lama tetap tampil benar; tidak lagi bisa dipilih warga untuk pengajuan baru.
  KARTU_KELUARGA
  KK_BARCODE
  KK_PISAH
  KK_TAMBAH_ANGGOTA
  AKTE_KEMATIAN
  AKTE_KELAHIRAN
}

enum RequestStatus {
  DICEK
  DIPROSES
  DITOLAK
  SELESAI
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

/// Nomor WA mana yang terlibat dalam sebuah pesan kotak masuk - SERVICE untuk nomor bot
/// layanan (BotSession), SECONDARY untuk nomor kedua yang murni perangkat tertaut manual
/// (SecondaryAccountSession). Dipakai memisahkan dua percakapan yang kebetulan sama-sama
/// dengan warga yang sama tapi lewat nomor kami yang berbeda.
enum InboxChannel {
  SERVICE
  /// Salah satu akun ekstra (lihat ExtraAccount.id lewat InboxMessage.extraAccountId) -
  /// dulu namanya SECONDARY waktu cuma bisa satu akun tambahan, sekarang bisa banyak.
  EXTRA
}

/// Akun petugas/admin dashboard.
model Admin {
  id               Int             @id @default(autoincrement())
  username         String          @unique
  passwordHash     String
  name             String
  failedLoginCount Int             @default(0)
  lockedUntil      DateTime?
  // Lockout TERPISAH dari failedLoginCount/lockedUntil di atas (yang khusus login
  // username+password) - ini untuk percobaan PIN /admin-xpawto yang gagal (lihat
  // lib/accessControl.ts), supaya sesi admin yang sudah valid tidak bisa dipakai untuk
  // brute-force PIN 6 digit tanpa batas.
  pinFailedCount   Int             @default(0)
  pinLockedUntil   DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  sessions         Session[]
  statusHistories  StatusHistory[]
  requestMessages  RequestMessage[]
  broadcasts       Broadcast[]
  humanTakeovers   HumanTakeover[]
  inboxMessages    InboxMessage[]
}

/// Kalau ada baris untuk suatu waJid, bot BERHENTI TOTAL membalas otomatis (menu/status/dsb)
/// ke nomor itu - petugas sedang mengambil alih percakapan lewat dashboard secara manual.
/// Pesan warga tetap dicatat ke RequestMessage supaya kelihatan di chat dashboard, bot cuma
/// tidak ikut-ikutan membalas. Baris dihapus saat petugas melepas toggle (bot aktif lagi).
model HumanTakeover {
  waJid       String   @id
  activatedAt DateTime @default(now())
  adminId     Int?
  admin       Admin?   @relation(fields: [adminId], references: [id])
}

/// Sesi login dashboard, disimpan di DB (bukan JWT) supaya logout = revoke langsung.
model Session {
  id        String   @id @default(cuid())
  adminId   Int
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([adminId])
}

/// Singleton (id selalu 1) yang merefleksikan status koneksi nomor WA bot untuk dashboard.
model BotSession {
  id              Int       @id @default(1)
  waJid           String?
  phoneNumber     String?
  connected       Boolean   @default(false)
  lastConnectedAt DateTime?
  updatedAt       DateTime  @updatedAt
}

/// Singleton (id selalu 1) - kredensial gerbang tambahan untuk satu halaman tertentu, tidak
/// pernah diedit lewat UI/API mana pun di aplikasi ini (satu-satunya jalur tulis adalah
/// script CLI terpisah yang dijalankan manual di server, lihat packages/db/scripts). pinHash
/// adalah hash satu arah (bcrypt) - tidak bisa dibalik untuk mendapat nilai aslinya lagi.
/// totpSecret (kalau diisi) adalah kunci bersama TOTP (RFC 6238, sama seperti Google
/// Authenticator/app Kata Sandi iPhone) yang dienkripsi AES-256-GCM - authentication tag GCM
/// membuat isinya tidak bisa diubah/ditambah sama sekali tanpa kunci yang dipegang server
/// (proses tulis ulang manual di luar aplikasi, bukan lewat baris kode mana pun di sini).
model AccessControl {
  id         Int      @id @default(1)
  pinHash    String
  totpSecret Bytes?
  updatedAt  DateTime @updatedAt
}

/// Nomor WA kedua yang ditautkan terpisah dari nomor layanan (BotSession) - dipakai murni
/// sebagai perangkat tertaut manual (bukan bot, tidak menjalankan alur menu/otomatis apa
/// pun), supaya petugas bisa chat langsung dari /admin-xpawto tapi tetap tercatat terpusat.
/// Singleton sama seperti BotSession.
/// Nomor WA "ekstra" - perangkat tertaut manual (bukan bot layanan), bisa lebih dari satu
/// (Akun Kedua, Akun Ketiga, dst). Menggantikan SecondaryAccountSession yang dulu singleton
/// (cuma bisa satu akun tambahan) - sekarang tiap baris di sini adalah satu akun terpisah,
/// masing-masing dengan folder auth Baileys sendiri (lihat wa/extraAccountManager.ts).
model ExtraAccount {
  id              Int       @id @default(autoincrement())
  label           String
  waJid           String?
  phoneNumber     String?
  connected       Boolean   @default(false)
  lastConnectedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  inboxMessages InboxMessage[]
  callLogs      CallLog[]
}

/// @deprecated Digantikan oleh ExtraAccount (mendukung lebih dari satu akun tambahan).
/// Tabel ini dibiarkan ada (data lama tidak dihapus) tapi tidak lagi ditulis/dibaca kode.
model SecondaryAccountSession {
  id              Int       @id @default(1)
  waJid           String?
  phoneNumber     String?
  connected       Boolean   @default(false)
  lastConnectedAt DateTime?
  updatedAt       DateTime  @updatedAt
}

/// State mesin percakapan per nomor WA, selama warga masih mengisi formulir/upload syarat.
/// Sengaja terpisah dari model Request supaya antrian admin cuma berisi pengajuan yang sudah lengkap.
model ConversationState {
  id                  Int      @id @default(autoincrement())
  waJid               String   @unique
  state               String
  requirementsSnapshot Json?
  contextJson         Json?
  expiresAt           DateTime
  /// Diisi sekali saat reminder "pengajuan belum selesai" terkirim, supaya warga tidak
  /// di-spam berkali-kali kalau tetap idle melewati beberapa siklus job pengingat.
  reminderSentAt      DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([expiresAt])
}

/// Daftar syarat dokumen per layanan, bisa diedit admin lewat dashboard.
model RequirementTemplate {
  id          Int         @id @default(autoincrement())
  serviceType ServiceType
  name        String
  description String?
  order       Int
  active      Boolean     @default(true)
  /// Kalau true, berkas yang dikirim warga untuk syarat ini akan di-OCR (dicari NIK-nya)
  /// sebagai petunjuk petugas - bukan pengganti verifikasi manual.
  ocrKtp      Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([serviceType])
}

/// Pengajuan warga yang sudah lengkap syaratnya (dibuat setelah semua dokumen terupload).
model Request {
  id                String        @id @default(cuid())
  /// Nomor tiket yang mudah dibacakan warga ke petugas, format KODE-YYMM-0001.
  ticketNumber      String        @unique
  serviceType       ServiceType
  applicantName     String
  waJid             String
  waNumber          String
  status            RequestStatus @default(DICEK)
  rejectionReason   String?
  pickupToken       String        @unique
  pickupTokenUsedAt DateTime?
  /// Token acak panjang untuk URL halaman lacak publik (/track/[trackingToken]) - SENGAJA
  /// terpisah dari pickupToken (yang dipakai scan QR fisik di loket). Tanpa ini, ticketNumber
  /// (sekuensial per layanan+bulan, gampang ditebak) bisa dipakai orang lain untuk melihat
  /// status/nama/alasan penolakan pemohon lain (IDOR) - trackingToken jadi "kunci" yang cuma
  /// dikirim bot ke WhatsApp pemohon aslinya.
  trackingToken     String        @unique
  qrGeneratedAt     DateTime?
  pickupConfirmedAt DateTime?
  completedAt       DateTime?
  notifiedStatus    RequestStatus?
  notifiedAt        DateTime?
  /// Diisi saat admin menekan "Kirim Notifikasi Siap Diambil" (bisa ditekan ulang untuk resend).
  readyForPickupRequestedAt DateTime?
  /// Diisi bot setelah pesan siap-diambil (berisi QR) benar-benar terkirim.
  readyForPickupSentAt      DateTime?
  /// Diisi sekali saat reminder otomatis "belum diambil" terkirim, supaya warga tidak di-spam berkali-kali.
  pickupReminderSentAt      DateTime?
  /// Diisi bot saat minta rating (begitu status SELESAI). Dipakai jadi jendela waktu balasan
  /// angka 1-5 dianggap sebagai rating, bukan pilihan menu layanan baru.
  ratingRequestedAt DateTime?
  ratingSubmittedAt DateTime?
  /// 1-5, diisi warga lewat balasan chat setelah dokumen diambil.
  rating            Int?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  documents       RequestDocument[]
  statusHistories StatusHistory[]
  messages        RequestMessage[]

  @@index([waJid])
  @@index([status])
}

/// Penghitung nomor urut tiket per layanan+bulan, di-increment atomik lewat raw SQL
/// (INSERT ... ON DUPLICATE KEY UPDATE ... LAST_INSERT_ID) supaya aman dari race condition
/// saat dua pengajuan pada layanan & bulan yang sama selesai hampir bersamaan.
model TicketSequence {
  id          Int         @id @default(autoincrement())
  serviceType ServiceType
  yearMonth   String
  lastNumber  Int         @default(0)

  @@unique([serviceType, yearMonth])
}

/// Nomor WA petugas yang dikabari otomatis tiap ada pengajuan baru masuk (status DICEK).
model StaffContact {
  id        Int      @id @default(autoincrement())
  waNumber  String
  label     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// Berkas syarat (foto/PDF) yang sudah dipindah ke penyimpanan permanen untuk sebuah Request.
model RequestDocument {
  id              Int      @id @default(autoincrement())
  requestId       String
  request         Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requirementName String
  fileName        String
  filePath        String
  mimeType        String
  uploadedAt      DateTime @default(now())
  /// Hasil OCR (kalau syaratnya ditandai ocrKtp) - petunjuk saja, petugas tetap wajib
  /// mencocokkan dengan foto aslinya secara manual.
  ocrNik          String?
  ocrRawText      String?  @db.Text

  @@index([requestId])
}

/// Log percakapan bebas (di luar alur formulir baku) antara petugas dan warga untuk satu
/// pengajuan - OUTBOUND = petugas kirim lewat dashboard, INBOUND = warga chat bebas ke bot
/// saat pengajuannya masih aktif (DICEK/DIPROSES).
model RequestMessage {
  id        Int              @id @default(autoincrement())
  requestId String
  request   Request          @relation(fields: [requestId], references: [id], onDelete: Cascade)
  direction MessageDirection
  message   String           @db.Text
  adminId   Int?
  admin     Admin?           @relation(fields: [adminId], references: [id])
  createdAt DateTime         @default(now())
  /// Diisi kalau pesan ini punya lampiran (mis. voice note warga yang tidak bisa dipahami
  /// bot - direkam & diteruskan apa adanya supaya petugas bisa dengar langsung). Path relatif
  /// ke UPLOAD_DIR, file-nya terenkripsi AES-256-GCM sama seperti berkas syarat lainnya.
  attachmentPath     String?
  attachmentMimeType String?

  @@index([requestId])
}

/// Log pengumuman massal admin ke semua warga yang pernah punya pengajuan (distinct waJid).
model Broadcast {
  id              Int      @id @default(autoincrement())
  message         String   @db.Text
  recipientCount  Int
  adminId         Int?
  admin           Admin?   @relation(fields: [adminId], references: [id])
  createdAt       DateTime @default(now())
}

/// Log SEMUA pesan masuk dari nomor WA manapun, terlepas dia punya Request aktif atau tidak -
/// beda dari RequestMessage yang cuma hidup dalam konteks satu pengajuan. Ini dipakai halaman
/// "Pesan Masuk" di dashboard supaya petugas bisa lihat & balas warga yang chat di luar alur
/// formulir (mis. baru sekadar tanya-tanya, belum pernah mengajukan apa pun).
model InboxMessage {
  id                 Int              @id @default(autoincrement())
  waJid              String
  waNumber           String
  channel            InboxChannel     @default(SERVICE)
  // Diisi cuma kalau channel = EXTRA - akun ekstra mana yang menerima/mengirim pesan ini.
  extraAccountId     Int?
  extraAccount       ExtraAccount?    @relation(fields: [extraAccountId], references: [id])
  direction          MessageDirection
  message            String           @db.Text
  attachmentPath     String?
  attachmentMimeType String?
  // Grup WA (cuma berlaku untuk channel EXTRA - lihat extraAccountMessageHandler.ts).
  // waJid untuk pesan grup adalah JID grupnya sendiri (...@g.us), bukan JID satu orang -
  // senderNumber/senderName menyimpan siapa yang benar-benar mengirim pesan itu di dalam
  // grup, karena satu "percakapan" grup berisi banyak pengirim berbeda.
  isGroup            Boolean          @default(false)
  // Channel WA (JID diakhiri ...@newsletter) - siaran satu arah dari pengelola channel,
  // BUKAN percakapan dua arah (tidak ada "sender" perorangan, tidak bisa dibalas). Nama
  // channel-nya dipakai field groupName yang sama (generik "nama tampilan non-1:1").
  isChannel          Boolean          @default(false)
  groupName          String?
  senderNumber       String?
  senderName         String?
  adminId            Int?
  admin              Admin?           @relation(fields: [adminId], references: [id])
  createdAt          DateTime         @default(now())
  // ID pesan asli dari WhatsApp (msg.key.id) - dicatat supaya kalau pengirimnya MENGEDIT
  // pesan itu belakangan, kita bisa cari baris yang tepat ini dan update isinya di tempat,
  // bukan bikin baris baru. editedAt diisi cuma kalau pesan ini pernah diedit (null berarti
  // belum pernah) - dipakai UI untuk kasih tanda "diedit" di pesan itu.
  waMessageId        String?
  editedAt           DateTime?
  // Status centang WA untuk pesan KELUAR yang dikirim SETELAH fitur ini ada (SENT/
  // DELIVERED/READ) - diperbarui lewat event messages.update (lihat messageStatusHandler
  // di messageHandler.ts). Tetap null untuk pesan MASUK (tidak relevan) dan pesan lama dari
  // sebelum fitur ini dibangun (tidak retroaktif, tidak ada datanya).
  status             String?
  // Diisi lewat protocolMessage tipe REVOKE (WhatsApp mengirim ini saat siapa pun menghapus
  // pesan yang sudah terkirim) - lihat applyMessageDelete di messageLog.ts. Isi `message`
  // SENGAJA TIDAK dihapus/ditimpa - baris ini cuma ditandai, supaya riwayat percakapan tetap
  // utuh untuk keperluan audit (justru inti dari fitur ledger di atas), UI cukup menampilkan
  // penanda "dihapus" di sampingnya.
  deletedAt          DateTime?
  // Koordinat share-lokasi/live-location (kalau ada) - dipakai UI merender pratinjau peta
  // kecil di bubble chat, bukan cuma tautan Google Maps polos seperti sebelumnya. `message`
  // tetap menyimpan teks terformat lengkap (termasuk link) untuk kompatibilitas mundur.
  latitude           Float?
  longitude          Float?
  reactions          MessageReaction[]
  // Pesan yang DITERUSKAN (forward) dari chat lain manapun - lihat extractIsForwarded di
  // messageHandler.ts. Ditandai UI dengan label "Diteruskan" persis WA.
  isForwarded        Boolean          @default(false)
  // "Membalas pesan X" (reply/kutipan) - lihat extractQuotedInfo di messageHandler.ts.
  // quotedWaMessageId dipakai UI mencocokkan ke pesan yang sama persis kalau kebetulan masih
  // ada di jendela thread yang sedang dimuat (bisa lompat/scroll ke situ); quotedPreview
  // sudah diekstrak & disimpan PERMANEN saat pesan ini pertama masuk (ringkasan teks/label
  // media pesan asli), jadi tetap bisa ditampilkan meski pesan aslinya di luar jendela yang
  // sedang dimuat atau (secara teori) sudah tidak ada lagi di database.
  quotedWaMessageId  String?
  quotedPreview      String?

  @@index([waJid])
  @@index([channel])
  @@index([extraAccountId])
  @@index([waMessageId])
  @@index([createdAt])
}

/// Reaksi emoji (👍❤️😂 dst) ke satu pesan - satu baris per (pesan, pereaksi), APPEND/UPDATE
/// di tempat (bukan baris baru tiap kali) supaya kalau orang yang sama ganti reaksi atau
/// membatalkannya, riwayat "siapa reaksi apa sekarang" tetap rapi satu baris per orang -
/// sama seperti bagaimana WhatsApp sendiri memperlakukannya. emoji="" berarti reaksi itu
/// SUDAH DIBATALKAN pengirimnya (WhatsApp mengirim reactionMessage dengan text kosong untuk
/// ini) - baris tetap disimpan (bukan dihapus) supaya jejaknya ada di ledger, UI cukup
/// menyembunyikan baris dengan emoji kosong dari tampilan.
model MessageReaction {
  id             Int          @id @default(autoincrement())
  inboxMessageId Int
  inboxMessage   InboxMessage @relation(fields: [inboxMessageId], references: [id])
  // JID pereaksi (nomor asli kalau grup/pihak lain), atau "self" kalau kita/petugas sendiri
  // yang reaksi dari HP - "self" dipakai apa adanya (bukan JID akun sendiri) supaya tidak
  // perlu resolusi JID tambahan, cukup untuk keperluan tampilan siapa yang reaksi.
  reactorJid     String
  reactorName    String?
  emoji          String
  updatedAt      DateTime     @updatedAt

  @@unique([inboxMessageId, reactorJid])
  @@index([inboxMessageId])
}

/// Riwayat panggilan (suara/video) - dicatat TERPISAH dari InboxMessage (yang juga tetap
/// dapat baris "[Panggilan ... - hasilnya]" apa adanya supaya tetap kelihatan inline di
/// thread persis seperti WA) supaya bisa punya tab "Riwayat Panggilan" tersendiri di
/// /admin-xpawto tanpa harus menyaring teks InboxMessage dengan awalan string - query
/// langsung ke tabel terstruktur ini jauh lebih murah & tidak rapuh.
model CallLog {
  id             Int          @id @default(autoincrement())
  waJid          String
  waNumber       String
  channel        InboxChannel
  extraAccountId Int?
  extraAccount   ExtraAccount? @relation(fields: [extraAccountId], references: [id])
  isVideo        Boolean
  isGroup        Boolean      @default(false)
  groupName      String?
  /// "diangkat" | "ditolak" | "tidak dijawab" | "ditolak otomatis" (nomor layanan) - lihat
  /// conversation/callHandler.ts & extraAccountCallHandler.ts.
  outcome        String
  createdAt      DateTime     @default(now())

  @@index([channel, extraAccountId, createdAt])
  @@index([waJid])
}

/// Cache foto profil WA per kontak. Baileys tidak pernah MENGIRIMKAN foto profil lewat
/// event pesan biasa - harus diminta eksplisit lewat `sock.profilePictureUrl(jid)`, dan itu
/// memanggil server WhatsApp per kontak, jadi WAJIB di-cache (memanggil terlalu sering per
/// buka halaman berisiko dianggap pola pemakaian otomatis yang mencurigakan, sama seperti
/// kekhawatiran broadcast massal yang sudah didokumentasikan di README/plan proyek ini).
/// `extraAccountId` sengaja Int NOT NULL dengan sentinel 0 (bukan nullable) - MySQL
/// menganggap NULL tidak pernah sama dengan NULL lain di dalam unique index gabungan,
/// jadi kalau dibiarkan nullable, channel SERVICE (yang selalu tanpa akun ekstra) bisa
/// kebobolan baris dobel per waJid alih-alih benar-benar unik.
model ContactAvatar {
  id             Int          @id @default(autoincrement())
  waJid          String
  channel        InboxChannel
  extraAccountId Int          @default(0)
  /// null = sudah dicek ke WA dan TIDAK ada foto profil (atau tidak diizinkan lihat) -
  /// baris tetap disimpan supaya tidak nanya ulang ke WA terus-menerus tiap dibuka.
  imagePath      String?
  mimeType       String?
  fetchedAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([waJid, channel, extraAccountId])
}

/// Buku besar audit terenkripsi HMAC, berantai (setiap baris mengunci baris sebelumnya lewat
/// prevHash) - APPEND-ONLY, tidak pernah di-UPDATE/DELETE oleh kode aplikasi mana pun. Dipakai
/// membuktikan riwayat InboxMessage ("Pesan Masuk") tidak pernah diubah di luar jalur resmi
/// aplikasi (mis. lewat SQL manual langsung ke database) - lihat packages/db/src/auditLedger.ts
/// untuk mekanisme lengkap & keterbatasannya, dan lib/accessControl.ts (web) untuk pola
/// HMAC/AES serupa yang sudah dipakai di proyek ini.
///
/// prevHash & hash SENGAJA @unique - lapisan jaga-jaga TERAKHIR supaya rantai tidak pernah
/// bisa bercabang biar bagaimanapun (kalau isi baris ganda persis, MySQL sendiri yang
/// menolaknya). Mutual-exclusion yang SESUNGGUHNYA (yang membuat dua proses - bot & web,
/// sama-sama bisa membuat InboxMessage baru - aman menulis ke rantai yang sama bersamaan)
/// dipegang row lock `SELECT ... FOR UPDATE` di AuditLedgerTail, lihat model itu dan
/// appendLedgerEntry di packages/db/src/auditLedger.ts.
model AuditLedgerEntry {
  id             Int      @id @default(autoincrement())
  eventType      String
  inboxMessageId Int
  payload        String   @db.Text
  prevHash       String   @unique
  hash           String   @unique
  createdAt      DateTime @default(now())

  @@index([inboxMessageId])
}

/// Singleton (id selalu 1) - cuma menyimpan hash entri TERAKHIR AuditLedgerEntry. Dikunci
/// lewat `SELECT ... FOR UPDATE` di appendLedgerEntry - INI (bukan GET_LOCK ataupun
/// isolation level Prisma, dua-duanya sempat dicoba dan sama-sama TERBUKTI GAGAL lewat
/// stress test konkuren nyata) yang benar-benar menjaga penyambungan rantai aman ditulis dari
/// banyak proses/koneksi sekaligus. Row lock InnoDB WAJIB membaca versi TERBARU yang sudah
/// commit (beda dari SELECT biasa yang kena snapshot beku di bawah REPEATABLE READ, isolasi
/// default MySQL - persis inilah sebab GET_LOCK saja dulu masih bisa bentrok: urutan
/// eksekusinya sudah benar terserialisasi, tapi pembacaannya tetap basi).
model AuditLedgerTail {
  id       Int    @id @default(1)
  lastHash String
}

/// Sakelar gembok utama /admin-xpawto ("Time-Based Kill Switch"). Singleton (id selalu 1).
/// Defaultnya SELALU terkunci (unlockedUntil null, atau sudah lewat) - PIN+TOTP yang benar
/// sekalipun TETAP ditolak selama terkunci (lihat requireVerifiedAdmin & verify-pin/route.ts
/// di apps/web). Satu-satunya cara membuka: kirim "/unlock <durasi>" ke bot Telegram, dari
/// CHAT ID PEMILIK YANG SUDAH DIKONFIGURASI SAJA (TELEGRAM_NOTIFY_CHAT_ID) - lihat
/// apps/bot/src/notify/telegramCommands.ts, bukan siapa pun yang kebetulan tahu bot-nya.
/// Otomatis terkunci lagi begitu unlockedUntil lewat - dibandingkan ke waktu sekarang tiap
/// kali dicek (self-expiring), SENGAJA tanpa job terjadwal yang "mengunci ulang" supaya
/// tidak ada risiko job itu gagal/lupa jalan lalu gembok kelupaan terbuka. Jalur break-glass
/// manual (tanpa Telegram sama sekali, kalau bot down/token hilang) ada di
/// packages/db/scripts/setMasterLock.ts, wajib dijalankan langsung di server.
model AdminLockState {
  id            Int       @id @default(1)
  unlockedUntil DateTime?
  updatedAt     DateTime  @updatedAt
}

/// Catatan monitoring: input warga/pengunjung yang polanya menyerupai percobaan SQL
/// Injection/XSS. Ini murni defense-in-depth logging (Prisma sudah parameterized query
/// di semua tempat jadi tidak ada celah SQLi nyata) - tujuannya supaya admin bisa lihat
/// kalau ada yang sedang mencoba probing sistem, bukan bukti sistem berhasil ditembus.
model SecurityLog {
  id        Int      @id @default(autoincrement())
  ip        String
  path      String
  field     String
  value     String   @db.Text
  pattern   String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([ip])
}

/// Jejak audit perubahan status tiap Request.
model StatusHistory {
  id          Int           @id @default(autoincrement())
  requestId   String
  request     Request       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  status      RequestStatus
  note        String?
  changedById Int?
  changedBy   Admin?        @relation(fields: [changedById], references: [id])
  changedAt   DateTime      @default(now())

  @@index([requestId])
}
